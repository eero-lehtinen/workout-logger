{
  "name": "workout-logger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @workout-logger/web dev",
    "start": "pnpm --filter @workout-logger/server start",
    "storybook": "pnpm --filter @workout-logger/web storybook",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "e2e": "pnpm --filter @workout-logger/web e2e",
    "android:sync": "pnpm --filter @workout-logger/web build && pnpm --filter @workout-logger/web exec cap sync android",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tanstack/router-core": "^1.171.39",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
